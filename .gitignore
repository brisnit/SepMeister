# Dependencies
node_modules
.pnp
.pnp.js

# Build output
.next
out
build
dist

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local prepress artifacts — films, proofs and customer artwork must never
# be committed. Exports land wherever the browser downloads to, but these
# patterns guard against anyone dropping them in the repo.
/tmp-out
/exports
/films
*-separations.zip
*-test-package.zip
sep-ai-feedback-*.json

# Reference imagery dropped in locally. brandassets/UI.png is a watermarked
# stock image the app does not reference; committing watermarked stock to a
# hosted repo carries licensing risk. The SepWiz mark is our own artwork and
# is kept, since the shipped icons are generated from it.
brandassets/*
!brandassets/SepWizLogo.png

# OS and editor
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
